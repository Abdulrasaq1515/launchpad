# ── SoroPad configuration ────────────────────────────────────────────────
#
# Copy to frontend/.env.local and fill in. Everything here is NEXT_PUBLIC_*,
# so treat it all as public: never put a secret key in this file.
#
# The only values you MUST set to launch tokens are the factory addresses.
# Every other variable has a working default for testnet.

# ── Which factory launches tokens ────────────────────────────────────────
# A token launch is one atomic call to the factory's deploy_token, so a
# network without a factory cannot launch anything. Deploy one with:
#   npx tsx scripts/bootstrap-network.ts --network testnet --source <identity>
NEXT_PUBLIC_FACTORY_ADDRESS_TESTNET=CAMMOVC7NOIQYRLHBPALGOXEODTWDW4NFEKHFWI77NSIRC47BFRWPB2D
NEXT_PUBLIC_FACTORY_ADDRESS_MAINNET=
# Single-network fallback, used when the per-network variable above is unset.
NEXT_PUBLIC_FACTORY_ADDRESS=

# ── Network endpoints ────────────────────────────────────────────────────
# Defaults are correct for testnet; override only to use your own infra.
NEXT_PUBLIC_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org

# SDF runs no public mainnet Soroban RPC. The built-in default is a community
# endpoint — point this at your own provider before going live.
NEXT_PUBLIC_MAINNET_SOROBAN_RPC_URL=
NEXT_PUBLIC_MAINNET_HORIZON_URL=https://horizon.stellar.org

# NEXT_PUBLIC_TESTNET_RPC_URL and NEXT_PUBLIC_MAINNET_RPC_URL are accepted as
# legacy aliases of the two _SOROBAN_RPC_URL variables above. Prefer the names
# used here; the aliases exist only so older .env files keep working.

# Single-network fallbacks, read when the per-network variables are unset.
# Handy for a deployment that only ever talks to one network.
NEXT_PUBLIC_SOROBAN_RPC_URL=
NEXT_PUBLIC_HORIZON_URL=
NEXT_PUBLIC_NETWORK_PASSPHRASE=

# ── Absolute URL of this deployment ──────────────────────────────────────
# Used to build Open Graph / social-card URLs, which must be absolute.
# Without it they resolve against http://localhost:3000 and break in prod.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Mercury indexer (optional) ───────────────────────────────────────────
# Without a token the activity feed, transaction history and
# /api/tokens/recent degrade gracefully rather than failing.
NEXT_PUBLIC_MERCURY_AUTH_TOKEN=
NEXT_PUBLIC_MERCURY_TESTNET_URL=
NEXT_PUBLIC_MERCURY_MAINNET_URL=
NEXT_PUBLIC_MERCURY_BASE_URL=

# ── Contract WASM hashes ─────────────────────────────────────────────────
# Not env vars: read from contracts/wasm-manifest.json and served by
# /api/wasm-manifest. Refreshed by scripts/bootstrap-network.ts.
